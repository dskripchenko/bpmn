{
  "name": "@dskripchenko/bpmn",
  "version": "0.0.0",
  "description": "BPMN 2.0 diagrams to SVG with zero runtime dependencies and no DOM — reads the XML of Camunda Modeler, bpmn.io and other BPMN tools, laid out as they saved it",
  "keywords": [
    "bpmn",
    "bpmn2",
    "bpmn-viewer",
    "business-process",
    "workflow",
    "camunda",
    "svg",
    "diagram",
    "zero-dependency",
    "ssr"
  ],
  "homepage": "https://github.com/dskripchenko/bpmn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/bpmn.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/bpmn/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "eslint": "^10.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
